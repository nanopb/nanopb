# Regression test for submsg_callback on an extension field:
# pb_dec_submessage()/pb_enc_submessage() called extension->dest as a function

Import("env")

env.NanopbProto("extension.proto")
p = env.Program(["submsg_callback_extension.c", "extension.pb.c", "$COMMON/pb_decode.o", "$COMMON/pb_encode.o", "$COMMON/pb_common.o"])
env.RunTest(p)
