# Regression test: a pointer submessage that occurs more than once in the
# input must be merged like a static submessage, not replaced.

Import("env", "malloc_env")

env.NanopbProto("merge.proto")

test = malloc_env.Program(["merge.c",
                    "merge.pb.c",
                    "$COMMON/pb_decode_with_malloc.o",
                    "$COMMON/pb_common_with_malloc.o",
                    "$COMMON/malloc_wrappers.o"])

env.RunTest(test)
